{
  "name": "marble-trace",
  "description": "iRacing Telemetry Overlay",
  "private": true,
  "version": "0.26.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "repository": {
    "url": "https://github.com/mvoof/Marble-Trace"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features dev",
    "version-bump": "node scripts/bump-version.mjs",
    "wheel:trace": "uv run --no-project scripts/trace-wheel-svg.py",
    "tauri:build:release": "tauri build",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.dev.conf.json --no-sign --features dev",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write \"./**/*.{js,jsx,ts,tsx,json,scss,md}\"",
    "format:check": "oxfmt --check \"./**/*.{js,jsx,ts,tsx,json,scss,md}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "capture:widgets": "node scripts/capture-widgets.mjs",
    "perf": "node scripts/perf-run.mjs",
    "perf:build": "node scripts/perf-run.mjs --build",
    "perf:game": "node scripts/perf-game.mjs",
    "cargo:format": "cd src-tauri && cargo fmt",
    "test": "vitest run",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "antd": "^6.6.6",
    "flag-icons": "^7.5.0",
    "i18next": "^26.4.6",
    "lucide-react": "^1.57.0",
    "mobx": "^7.0.6",
    "mobx-react-lite": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.17",
    "sass": "^1.105.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.5.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-onboarding": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.64.1",
    "storybook": "^10.6.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
