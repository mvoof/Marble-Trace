{
  "plugins": ["typescript", "react", "jsx-a11y"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "react-hooks/exhaustive-deps": "error",
    "react-hooks/rules-of-hooks": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@tauri-apps/api/core"],
            "message": "Tauri invoke is wrapped by src/shared/api/ — call a service instead."
          },
          {
            "group": ["@tauri-apps/api/event"],
            "message": "Tauri events are wrapped by src/shared/api/events.service.ts — use listenTo/emitToApp/emitToOverlays."
          },
          {
            "group": ["@tauri-apps/plugin-store"],
            "message": "Settings-file persistence lives in src/app/sync and track-map.store.ts."
          }
        ]
      }
    ]
  },
  "env": {
    "browser": true,
    "es2020": true
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "src-tauri/target/**",
    "src-tauri/gen/schemas/**",
    "src/shared/contracts/bindings.ts",
    "src/storybook/__mocks__/**",
    ".storybook/**"
  ],
  "overrides": [
    {
      "files": ["scripts/**/*.{js,mjs}", "vite.config.ts"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["src/shared/contracts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@tauri-apps/**",
                  "@app/**",
                  "@pages/**",
                  "@widgets/**",
                  "@features/**"
                ],
                "message": "src/shared/contracts/ is the contract every layer reads: the backend types generated by specta plus the hand-written domain types. It depends on nothing."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/lib/**",
        "src/shared/ui/**",
        "src/shared/hooks/**",
        "src/shared/settings-schema/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@tauri-apps/api/core",
                  "@tauri-apps/api/event",
                  "@tauri-apps/plugin-store"
                ],
                "message": "Tauri access lives in src/shared/api/."
              },
              {
                "group": [
                  "@app/**",
                  "@pages/**",
                  "@widgets/**",
                  "@features/**",
                  "@shared/api/**"
                ],
                "message": "src/shared/ is the bottom layer: no store, no app UI, no transport."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/entities/**", "src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@tauri-apps/api/core"],
                "message": "Tauri invoke is wrapped by src/shared/api/ — call a service instead."
              },
              {
                "group": ["@tauri-apps/api/event"],
                "message": "Tauri events are wrapped by src/shared/api/events.service.ts — use listenTo/emitToApp/emitToOverlays."
              },
              {
                "group": ["@tauri-apps/plugin-store"],
                "message": "Settings-file persistence lives in src/app/sync and track-map.store.ts."
              },
              {
                "group": ["@pages/**", "@app/windows/**"],
                "message": "Layer direction is app -> pages -> widgets -> features -> entities -> shared. A store must not reach into the UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/sync/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@tauri-apps/api/core"],
                "message": "Tauri invoke is wrapped by src/shared/api/ — call a service instead."
              },
              {
                "group": ["@tauri-apps/api/event"],
                "message": "Tauri events are wrapped by src/shared/api/events.service.ts — use listenTo/emitToApp/emitToOverlays."
              },
              {
                "group": ["@pages/**", "@app/windows/**"],
                "message": "sync/ wires transport to stores. The UI is downstream of both."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/api/**",
        "src/entities/layout/layout-background.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@app/roots/**",
                  "@app/windows/**",
                  "@pages/**",
                  "@widgets/**",
                  "@features/**"
                ],
                "message": "A service talks to the backend and knows nothing about app state. Payload types belong in src/shared/contracts/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/app/sync/persistence-sync.ts",
        "src/entities/track/track-map.store.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@tauri-apps/api/core"],
                "message": "Tauri invoke is wrapped by src/shared/api/ — call a service instead."
              },
              {
                "group": ["@tauri-apps/api/event"],
                "message": "Tauri events are wrapped by src/shared/api/events.service.ts — use listenTo/emitToApp/emitToOverlays."
              },
              {
                "group": ["@pages/**", "@app/windows/**"],
                "message": "Layer direction is app -> pages -> widgets -> features -> entities -> shared. A store must not reach into the UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/preview/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@app/roots/root-store-context",
                  "**/root-store-context",
                  "**/main-root-context",
                  "**/overlay-root-context",
                  "**/hud-root-context",
                  "@app/**",
                  "@pages/**",
                  "@shared/api/**",
                  "@shared/settings-schema/**",
                  "@tauri-apps/**"
                ],
                "message": "The preview store is isolated (ADR-0004 rule 1): a scenario or builder writes only into the RendererCore({ skipInit: true }) handed to it. No context hooks onto the running stores, no UI, no persistence."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/settings-schema/migrations/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@app/**",
                  "@pages/**",
                  "@widgets/**",
                  "@features/**",
                  "@shared/**",
                  "@entities/**",
                  "@/**",
                  "@tauri-apps/**"
                ],
                "message": "A migration must keep meaning what it meant the day it was written, and live types, defaults and registries move under it. Freeze what you need as a literal, and walk the blob with the structural helpers in ../blob."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/app/windows/**",
        "src/pages/**",
        "src/widgets/**",
        "src/features/**/*.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@shared/api/**", "@shared/settings-schema/**"],
                "message": "The UI talks to stores only: an OS or backend action belongs in a store method."
              },
              {
                "group": ["@tauri-apps/**"],
                "message": "The UI talks to stores only; Tauri sits behind src/shared/api/. Only the window shells may reach their own window, in the override below."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/widgets/**",
        "src/shared/ui/**",
        "src/shared/hooks/**",
        "src/app/windows/overlay/**",
        "src/app/windows/remote/**",
        "src/app/windows/hud/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@app/roots/main-root",
                  "@app/roots/main-root-context",
                  "**/main-root",
                  "**/main-root-context",
                  "**/main-live-widgets-context",
                  "**/layout-editor-context",
                  "**/companion-apps-context",
                  "**/twitch-auth-context",
                  "**/device-input-context",
                  "**/bindings-ui-context",
                  "**/remote-devices-context",
                  "**/fps-diagnostics-context",
                  "**/diagnostics-export-context",
                  "**/telemetry-inspector-context",
                  "**/track-rotation-context",
                  "**/preview-host-context"
                ],
                "message": "These windows never build a MainRoot: the editor, the inspector, diagnostics, companion apps, the device list and the preview worlds exist in the main window only, and their hooks throw anywhere else. Read the stores every window has (their own *-context files) instead."
              },
              {
                "group": ["@shared/api/**", "@shared/settings-schema/**"],
                "message": "The UI talks to stores only: an OS or backend action belongs in a store method."
              },
              {
                "group": ["@tauri-apps/**"],
                "message": "The UI talks to stores only; Tauri sits behind src/shared/api/. Only the window shells may reach their own window, in the override below."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/app/windows/main/MainWindow.tsx",
        "src/app/windows/main/AppHeader/WindowControls.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@shared/api/**", "@shared/settings-schema/**"],
                "message": "A window shell may start its window's sync and reach its own window — nothing else of the platform."
              },
              {
                "group": [
                  "@tauri-apps/api/core",
                  "@tauri-apps/api/event",
                  "@tauri-apps/plugin-*"
                ],
                "message": "A window shell may reach its own window (@tauri-apps/api/window, webviewWindow) — nothing else of Tauri."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/app/windows/overlay/OverlayWindow.tsx",
        "src/app/windows/overlay/OverlayCanvas/OverlayCanvas.tsx",
        "src/app/windows/hud/DiagnosticsHudWindow.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@app/roots/main-root",
                  "@app/roots/main-root-context",
                  "**/main-root",
                  "**/main-root-context",
                  "**/main-live-widgets-context",
                  "**/layout-editor-context",
                  "**/companion-apps-context",
                  "**/twitch-auth-context",
                  "**/device-input-context",
                  "**/bindings-ui-context",
                  "**/remote-devices-context",
                  "**/fps-diagnostics-context",
                  "**/diagnostics-export-context",
                  "**/telemetry-inspector-context",
                  "**/track-rotation-context",
                  "**/preview-host-context"
                ],
                "message": "These windows never build a MainRoot: the editor, the inspector, diagnostics, companion apps, the device list and the preview worlds exist in the main window only, and their hooks throw anywhere else. Read the stores every window has (their own *-context files) instead."
              },
              {
                "group": ["@shared/api/**", "@shared/settings-schema/**"],
                "message": "A window shell may start its window's sync and reach its own window — nothing else of the platform."
              },
              {
                "group": [
                  "@tauri-apps/api/core",
                  "@tauri-apps/api/event",
                  "@tauri-apps/plugin-*"
                ],
                "message": "A window shell may reach its own window (@tauri-apps/api/window, webviewWindow) — nothing else of Tauri."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/app/**/*.tsx",
        "src/pages/**/*.tsx",
        "src/widgets/**/*.tsx",
        "src/shared/ui/**/*.tsx",
        "src/features/**/*.tsx"
      ],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "property": "carDynamics",
            "message": "Hot field (60 Hz) — read only inside useReactiveDomWrite/useReactiveCanvasLoop, never in render body. See docs/rendering.md."
          },
          {
            "property": "carInputs",
            "message": "Hot field (60 Hz) — read only inside useReactiveDomWrite/useReactiveCanvasLoop, never in render body. See docs/rendering.md."
          },
          {
            "property": "carPositions",
            "message": "Hot field (60 Hz) — read only inside useReactiveDomWrite/useReactiveCanvasLoop, never in render body. See docs/rendering.md."
          },
          {
            "property": "lapDelta",
            "message": "Hot field (60 Hz) — read only inside useReactiveDomWrite/useReactiveCanvasLoop, never in render body. See docs/rendering.md."
          },
          {
            "property": "relative",
            "message": "Heavy per-car frame (10 Hz) — read only inside useReactiveDomWrite/useReactiveCanvasLoop, never in render body. See docs/rendering.md."
          },
          {
            "property": "proximity",
            "message": "Heavy per-car frame (10 Hz) — read only inside useReactiveDomWrite/useReactiveCanvasLoop, never in render body. See docs/rendering.md."
          },
          {
            "property": "driverEntries",
            "message": "Heavy per-car frame (10 Hz) — read only inside useReactiveDomWrite/useReactiveCanvasLoop, never in render body. See docs/rendering.md."
          },
          {
            "property": "fieldEntries",
            "message": "Heavy per-car frame (10 Hz), joined with the session roster — read only inside useReactiveDomWrite/useReactiveCanvasLoop, never in render body. See docs/rendering.md."
          }
        ]
      }
    },
    {
      "files": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.stories.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-properties": "off"
      }
    }
  ]
}
