{
  "plugins": ["typescript", "react", "jsx-a11y"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "react-hooks/exhaustive-deps": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@tauri-apps/api/core"],
            "message": "Tauri invoke is wrapped by src/services/ — call a service instead."
          },
          {
            "group": ["@tauri-apps/api/event"],
            "message": "Tauri events are wrapped by src/services/events.service.ts — use listenTo/emitToApp/emitToOverlays."
          },
          {
            "group": ["@tauri-apps/plugin-store"],
            "message": "Settings-file persistence lives in src/store/sync and track-map.widget.ts."
          }
        ]
      }
    ]
  },
  "env": {
    "browser": true,
    "es2020": true
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "src-tauri/target/**",
    "src-tauri/gen/schemas/**",
    "src/types/bindings.ts",
    "src/storybook/__mocks__/**",
    ".storybook/**"
  ],
  "overrides": [
    {
      "files": ["scripts/**/*.{js,mjs}", "vite.config.ts"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["src/services/**", "src/store/settings/layout-background.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/store/sync/persistence-sync.ts",
        "src/widgets/TrackMapWidget/track-map.widget.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@tauri-apps/api/core"],
                "message": "Tauri invoke is wrapped by src/services/ — call a service instead."
              },
              {
                "group": ["@tauri-apps/api/event"],
                "message": "Tauri events are wrapped by src/services/events.service.ts — use listenTo/emitToApp/emitToOverlays."
              }
            ]
          }
        ]
      }
    }
  ]
}
