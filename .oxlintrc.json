{
  "plugins": ["typescript", "react", "jsx-a11y"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "react-hooks/exhaustive-deps": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@tauri-apps/api/core"],
            "message": "Tauri invoke is wrapped by src/platform/services/ — call a service instead."
          },
          {
            "group": ["@tauri-apps/api/event"],
            "message": "Tauri events are wrapped by src/platform/services/events.service.ts — use listenTo/emitToApp/emitToOverlays."
          },
          {
            "group": ["@tauri-apps/plugin-store"],
            "message": "Settings-file persistence lives in src/platform/sync and track-map.widget.ts."
          }
        ]
      }
    ]
  },
  "env": {
    "browser": true,
    "es2020": true
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "src-tauri/target/**",
    "src-tauri/gen/schemas/**",
    "src/types/bindings.ts",
    "src/storybook/__mocks__/**",
    ".storybook/**"
  ],
  "overrides": [
    {
      "files": ["scripts/**/*.{js,mjs}", "vite.config.ts"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["src/utils/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@tauri-apps/api/core",
                  "@tauri-apps/api/event",
                  "@tauri-apps/plugin-store"
                ],
                "message": "Tauri access lives in src/platform/."
              },
              {
                "group": ["@store/**", "@ui/**", "@platform/**"],
                "message": "src/utils/ is the bottom layer: pure helpers, no store, no UI, no transport."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/store/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@tauri-apps/api/core"],
                "message": "Tauri invoke is wrapped by src/platform/services/ — call a service instead."
              },
              {
                "group": ["@tauri-apps/api/event"],
                "message": "Tauri events are wrapped by src/platform/services/events.service.ts — use listenTo/emitToApp/emitToOverlays."
              },
              {
                "group": ["@tauri-apps/plugin-store"],
                "message": "Settings-file persistence lives in src/platform/sync and track-map.widget.ts."
              },
              {
                "group": ["@ui/**"],
                "message": "Layer direction is ui -> store -> platform. A store must not reach into the UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/platform/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@tauri-apps/api/core"],
                "message": "Tauri invoke is wrapped by src/platform/services/ — call a service instead."
              },
              {
                "group": ["@tauri-apps/api/event"],
                "message": "Tauri events are wrapped by src/platform/services/events.service.ts — use listenTo/emitToApp/emitToOverlays."
              },
              {
                "group": ["@tauri-apps/plugin-store"],
                "message": "Settings-file persistence lives in src/platform/sync and track-map.widget.ts."
              },
              {
                "group": ["@store/**", "@ui/**"],
                "message": "platform/ knows the OS and the backend, not the app's state or UI. Only platform/sync may read stores."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/platform/sync/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@tauri-apps/api/core"],
                "message": "Tauri invoke is wrapped by src/platform/services/ — call a service instead."
              },
              {
                "group": ["@tauri-apps/api/event"],
                "message": "Tauri events are wrapped by src/platform/services/events.service.ts — use listenTo/emitToApp/emitToOverlays."
              },
              {
                "group": ["@ui/**"],
                "message": "sync/ wires transport to stores. The UI is downstream of both."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/platform/services/**",
        "src/store/settings/layout-background.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@store/**", "@ui/**"],
                "message": "A service talks to the backend and knows nothing about app state. Payload types belong in src/types/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/platform/sync/persistence-sync.ts",
        "src/ui/widgets/TrackMapWidget/track-map.widget.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@tauri-apps/api/core"],
                "message": "Tauri invoke is wrapped by src/platform/services/ — call a service instead."
              },
              {
                "group": ["@tauri-apps/api/event"],
                "message": "Tauri events are wrapped by src/platform/services/events.service.ts — use listenTo/emitToApp/emitToOverlays."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/store/root-store.ts", "src/store/widget-defaults.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@tauri-apps/api/core",
                  "@tauri-apps/api/event",
                  "@tauri-apps/plugin-store"
                ],
                "message": "Tauri access lives in src/platform/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.stories.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
