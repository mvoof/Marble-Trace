# Agent configuration. The shared contract is tracked: AGENTS.md, project
# skills under .agents/skills/, and the MCP server for visual testing. Personal
# settings, allow-lists and run state stay local because enabledPlugins can run
# third-party code on every machine that clones the repo; each developer opts
# in locally instead.
.claude/*

# Telemetry snapshots (captured from live iRacing sessions)
# test-data/*.json — tracked in git for CI typecheck / Storybook

# Local python env for scripts/trace-wheel-svg.py
.venv/
__pycache__/

# Agent scratch space (specs, tickets, wayfinding maps)
.scratch/

# Render-budget runs in browser mode (npm run test:perf)
**/__screenshots__/
.vitest-attachments/

# React Doctor writes its report here when asked for one.
react-doctor.json
