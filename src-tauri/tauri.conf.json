{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Marble Trace",
  "version": "0.25.0",
  "identifier": "com.voof.marble-trace",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "main.html",
        "title": "Marble Trace",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": [
          "'self'",
          "data:",
          "http://asset.localhost",
          "https://static-cdn.jtvnw.net",
          "https://*.ggpht.com",
          "https://*.googleusercontent.com",
          "https://fonts.gstatic.com",
          "https://www.youtube.com"
        ],
        "font-src": "'self'",
        "connect-src": ["'self'", "http://ipc.localhost"],
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": ["'self'", "'unsafe-inline'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": [
          "'self'",
          "data:",
          "http://asset.localhost",
          "https://static-cdn.jtvnw.net",
          "https://*.ggpht.com",
          "https://*.googleusercontent.com",
          "https://fonts.gstatic.com",
          "https://www.youtube.com"
        ],
        "font-src": "'self'",
        "connect-src": [
          "'self'",
          "http://ipc.localhost",
          "ws://localhost:1421"
        ],
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/backgrounds/*", "$APPDATA/backgrounds/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mvoof/Marble-Trace/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCOTk5QTRFNUUxNTc2RkUKUldUK2RoVmVUcHFadS81MVowVTRVQ3p2UHJkVVg0ZUxNdFJjV3F0WmpGM0p5dG5HenNZUXVPQ0sK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
