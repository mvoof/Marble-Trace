{
  "identifier": "com.voof.marble-trace",
  "app": {
    "security": {
      "csp": {
        "script-src": ["'self'", "'unsafe-inline'"]
      },
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "targets": ["nsis"],
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "npm run build -- --mode devtools"
  }
}
